[[0.0, 2.22, 0, "Ручка двери медленно повернулась сама."], [2.71, 3.2, 1, "Я отступил."], [3.73, 5.05, 2, "Но всё началось раньше."], [5.05, 6.78, 3, "Я очнулся на вершине Эвереста."], [6.78, 7.13, 4, "В доме,"], [7.13, 9.15, 4, "которого не было на нашем маршруте."], [9.74, 11.72, 5, "За окном чернело небо,"], [11.97, 12.96, 5, "а горы уходили вниз,"], [13.44, 15.68, 5, "будто весь мир провалился под снег."], [15.68, 17.69, 6, "На мне остались красная куртка,"], [18.2, 20.08, 6, "треснувший шлем и одна перчатка."], [20.57, 22.48, 7, "Вторую я потерял во время падения."], [22.88, 23.61, 8, "Я помнил ветер."], [23.61, 23.97, 9, "Помнил,"], [24.42, 25.77, 9, "как звал Веру по рации."], [26.28, 27.09, 10, "А потом —"], [27.64, 28.45, 10, "ничего."], [28.98, 30.3, 11, "Я позвал её снова."], [30.3, 30.86, 12, "Тишина."], [31.2, 34.16, 13, "В центре комнаты стояла железная печь."], [34.67, 36.37, 14, "В ней горел огонь,"], [36.83, 37.75, 14, "хотя дров не было."], [37.75, 39.19, 15, "На столе лежали две кружки."], [39.52, 40.63, 16, "Одна покрылась инеем."], [40.95, 42.16, 17, "Вторая была горячей."], [42.69, 44.51, 18, "Тогда я заметил бирки на стене."], [44.84, 45.83, 19, "Имена альпинистов,"], [46.4, 47.44, 19, "пропавших на Эвересте."], [47.84, 49.17, 20, "Некоторые я знал."], [49.67, 54.45, 21, "А между бирками кто-то оставил свежую царапину."], [54.94, 56.01, 22, "Рация зашипела."], [56.35, 58.26, 23, "И из динамика донёсся голос Веры:"], [58.64, 59.12, 24, "Илья…"], [59.47, 60.58, 24, "почему ты не ответил?"], [61.06, 61.72, 25, "Я замер."], [62.17, 64.03, 26, "Она не могла знать,"], [64.33, 66.58, 26, "что я здесь."], [67.07, 70.04, 27, "Но я действительно слышал её последний вызов."], [70.04, 71.6, 28, "Из стены ударили трижды."], [71.6, 73.95, 29, "Ручка двери начала поворачиваться."]]