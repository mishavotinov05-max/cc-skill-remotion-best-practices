[[0.05, 2.11, "Мне предложили миллиард долларов"], [2.09, 3.34, "за неделю молчания."], [3.65, 5.27, "Если я произнесу хоть одно"], [5.25, 7.54, "слово, то лишусь абсолютно всего."], [8.05, 9.08, "Я согласился,"], [9.23, 10.93, "и деньги сразу появились на"], [10.91, 11.58, "моём счёте."], [12.13, 13.95, "Первым делом я пошёл завтракать"], [13.93, 14.66, "перед школой."], [14.95, 15.85, "Мама спросила,"], [15.83, 17.45, "как дела, а я просто"], [17.43, 18.15, "прошёл мимо."], [18.51, 19.85, "В школе друг спросил,"], [19.83, 21.16, "сделал ли я домашку."], [21.53, 22.73, "Я молча кивнул,"], [22.92, 24.58, "но тут учитель вызвал меня"], [24.56, 25.05, "к доске."], [25.46, 26.64, "Я решил пример,"], [26.62, 28.48, "а когда меня попросили объяснить"], [28.46, 30.59, "решение, просто стоял и молчал."], [30.97, 32.63, "В итоге получил двойку."], [33.16, 34.74, "После школы я отправился в"], [34.72, 36.9, "автосалон и купил самую дорогую"], [36.88, 37.39, "машину."], [37.6, 39.58, "Продавец попросил назвать имя,"], [39.56, 41.28, "но я просто показал паспорт."], [41.67, 43.73, "Вечером я купил огромный особняк"], [43.71, 45.54, "с бассейном и переехал туда."], [46.03, 47.29, "Прошло шесть дней."], [47.56, 48.58, "Я почти ни с кем"], [48.56, 50.46, "не общался и уже представлял,"], [50.44, 52.34, "как потрачу оставшиеся деньги."], [52.73, 54.51, "До конца испытания оставались"], [54.49, 55.55, "считаные минуты."], [55.83, 57.74, "И вдруг мне позвонила мама."], [58.16, 59.01, "Она спросила:"], [59.39, 59.84, "«Сынок,"], [60.16, 60.94, "ты меня любишь?»"], [61.4, 63.37, "Я немного подумал и ответил:"], [63.93, 64.28, "«Да»."], [64.71, 65.85, "И в ту же секунду"], [65.83, 67.61, "понял, что это было самое"], [67.59, 68.81, "дорогое слово,"], [68.79, 70.78, "которое я когда-либо произносил."]]