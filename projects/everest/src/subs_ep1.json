[[0.13, 2.3, "Я очнулся на вершине Эвереста."], [2.69, 3.25, "В доме."], [3.79, 5.85, "За окном темнота и горы,"], [5.83, 6.93, "уходящие вниз,"], [6.91, 8.69, "словно весь мир провалился"], [8.67, 9.19, "под снег."], [9.77, 10.59, "Я был один."], [10.92, 11.76, "По крайней мере…"], [11.91, 12.99, "так мне показалось."], [13.39, 15.45, "На мне осталась красная куртка,"], [15.43, 17.73, "треснувший шлем и одна перчатка."], [18.17, 20.11, "Вторую я потерял во время падения."], [20.6, 21.34, "Я не помнил,"], [21.32, 22.51, "как оказался здесь."], [22.86, 24.02, "Помнил только ветер"], [24.37, 25.81, "и голос Веры в рации."], [26.26, 27.13, "Я позвал её."], [27.63, 28.49, "Ответа не было."], [28.91, 30.94, "В комнате стояла железная печь."], [31.18, 31.96, "Она горела,"], [31.94, 33.28, "хотя внутри не было ни"], [33.26, 34.2, "дров, ни угля."], [34.61, 36.42, "От её тепла кружилась голова."], [36.77, 38.71, "На столе лежали две металлические"], [38.69, 39.21, "кружки."], [39.5, 40.69, "Одна была ледяной."], [40.93, 42.22, "Вторая горячий."], [42.6, 44.54, "Тогда я заметил бирки на стене."], [44.82, 46.01, "Имена альпинистов."], [46.42, 47.5, "Некоторые я знал."], [47.78, 49.19, "Они пропали на этой горе."], [49.66, 51.72, "Между ними была свежая царапина,"], [51.7, 53.6, "будто кто-то только что пытался"], [53.58, 54.47, "что-то написать."], [54.97, 56.06, "Рация ожила."], [56.3, 58.28, "Из динамика донёсся голос Веры."], [58.64, 59.14, "Илья…"], [59.41, 60.64, "Почему ты не ответил?"], [61.12, 61.77, "Я замер."], [62.16, 63.3, "Она не могла знать,"], [63.28, 64.04, "что я здесь."], [64.27, 65.21, "И не могла знать,"], [65.19, 66.63, "что я слышал её вызов."], [67.01, 69.07, "Потом из стены раздался первый"], [69.05, 69.42, "удар."], [69.77, 70.33, "Второй."], [70.76, 71.27, "Третий."], [71.7, 73.72, "Ручка двери медленно повернулась."]]