[[0.09, 1.75, "Ручка медленно повернулась"], [1.73, 2.32, "до конца."], [2.81, 3.95, "Я отступил назад,"], [3.93, 5.67, "схватил фонарик и направил"], [5.65, 6.29, "его на дверь."], [6.94, 8.4, "Ещё секунда и она"], [8.38, 9.53, "резко распахнулась."], [10.08, 11.46, "Но за дверью никого"], [11.44, 11.9, "не было."], [12.32, 13.94, "Только снежная буря и"], [13.92, 15.01, "полная темнота."], [15.73, 17.15, "Я посветил фонариком на"], [17.13, 18.64, "снег и увидел следы."], [19.16, 20.62, "Они тянулись от самого"], [20.6, 22.3, "обрыва прямо к моей двери."], [22.72, 24.02, "Но возле порога следы"], [24.0, 25.01, "резко обрывались."], [25.36, 27.17, "Будто человек просто исчез."], [28.08, 29.3, "Я захлопнул дверь и"], [29.28, 30.58, "придвинул к ней тяжёлый"], [30.56, 30.9, "стол."], [31.35, 33.13, "И тут снова заработала"], [33.11, 33.58, "рация."], [34.04, 34.5, "Илья…"], [34.9, 35.91, "Не открывай дверь."], [36.27, 37.12, "Я вижу тебя."], [37.76, 38.71, "Это была Вера."], [39.18, 40.36, "Я бросился к окну,"], [40.34, 41.84, "но снаружи никого не было."], [42.42, 43.88, "Вдруг прямо на стекле"], [43.86, 45.92, "появились три длинные царапины."], [46.41, 47.43, "Я отскочил назад."], [47.87, 49.34, "Рация снова зашипела."], [49.71, 51.41, "Илья, посмотри на стену"], [51.39, 52.14, "возле печки."], [52.66, 54.45, "Я медленно повернул голову."], [54.9, 56.68, "На деревянной стене прямо"], [56.66, 57.72, "у меня на глазах"], [57.7, 59.44, "начали появляться буквы."], [59.74, 60.9, "Буква за буквой."], [61.58, 62.13, "БЕГИ."], [62.83, 64.09, "Я схватил рюкзак и"], [64.07, 65.61, "бросился к задней двери,"], [65.59, 66.53, "но не успел даже"], [66.51, 67.7, "прикоснуться к ручке."], [68.03, 69.65, "С другой стороны раздались"], [69.63, 70.79, "три сильных удара."], [71.29, 71.93, "Я замер."], [72.32, 72.88, "И вдруг…"], [73.13, 74.72, "услышал за дверью голос."], [75.14, 77.13, "«Илья, открой скорее»."], [77.68, 79.02, "Я узнал этот голос."], [79.49, 80.08, "Это был…"], [80.52, 81.96, "мой собственный голос."], [82.49, 83.88, "А потом он произнёс:"], [84.3, 85.36, "«Если ты сейчас не"], [85.34, 86.0, "откроешь,"], [85.98, 87.3, "мы оба здесь умрём»."], [87.75, 88.89, "И в этот момент"], [88.87, 90.37, "кто-то положил руку мне"], [90.35, 90.87, "на плечо."], [91.67, 93.21, "Продолжение следует."]]