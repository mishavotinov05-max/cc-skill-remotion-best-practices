[[0.05, 2.24, "Ручка двери медленно повернулась сама."], [2.69, 3.21, "Я отступил."], [3.71, 4.94, "Но всё началось раньше."], [4.94, 7.16, "Я очнулся на вершине Эвереста."], [7.16, 9.16, "В доме, которого не было на"], [9.73, 10.56, "нашем маршруте."], [11.0, 12.97, "За окном чернело небо,"], [13.43, 14.76, "а горы уходили вниз,"], [14.76, 16.19, "будто весь мир провалился под снег."], [16.19, 17.72, "На мне остались красная куртка,"], [18.19, 20.08, "треснувший шлем и одна перчатка."], [20.56, 22.48, "Вторую я потерял во время падения."], [22.87, 23.98, "Я помнил ветер. Помнил,"], [24.41, 25.78, "как звал Веру по рации."], [26.26, 27.1, "А потом —"], [27.63, 28.46, "ничего."], [28.97, 30.87, "Я позвал её снова. Тишина."], [31.18, 34.17, "В центре комнаты стояла железная печь."], [34.66, 35.91, "В ней горел огонь,"], [35.91, 36.39, "хотя дров"], [36.81, 37.41, "не было."], [37.41, 39.2, "На столе лежали две кружки."], [39.5, 40.64, "Одна покрылась инеем."], [40.92, 42.17, "Вторая была горячей."], [42.68, 44.52, "Тогда я заметил бирки на стене."], [44.82, 45.85, "Имена альпинистов,"], [46.38, 47.44, "пропавших на Эвересте."], [47.82, 49.18, "Некоторые я знал."], [49.66, 52.56, "А между бирками кто-то оставил"], [52.56, 54.45, "свежую царапину."], [54.93, 56.03, "Рация зашипела."], [56.34, 58.27, "И из динамика донёсся голос Веры:"], [58.64, 59.13, "Илья…"], [59.45, 60.59, "почему ты не ответил?"], [61.05, 61.73, "Я замер."], [62.16, 63.41, "Она не могла знать,"], [63.41, 64.03, "что я здесь."], [64.31, 66.6, "Но я действительно слышал её последний вызов."], [67.05, 69.37, "Из стены ударили трижды."], [69.75, 70.29, "Ручка двери"], [70.76, 71.26, "начала"], [71.66, 73.7, "поворачиваться."]]