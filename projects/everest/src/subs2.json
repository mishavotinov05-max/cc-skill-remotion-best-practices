[[0.05, 2.27, "Ручка дошла до конца,"], [2.79, 4.83, "и дверь начала открываться."], [4.83, 6.26, "Но всё началось раньше."], [6.78, 9.52, "За несколько секунд до этого я"], [10.08, 11.86, "услышал скрип за дверью и"], [12.36, 13.88, "отступил к печи."], [13.88, 14.97, "Дверь распахнулась."], [15.73, 16.75, "Снаружи никого."], [16.75, 17.54, "Только снег,"], [17.54, 18.62, "ветер и темнота."], [19.2, 20.74, "Я направил фонарик на"], [20.74, 22.28, "крыльцо и увидел следы."], [22.77, 25.01, "Они вели от края"], [25.36, 27.16, "обрыва прямо к дому."], [28.04, 30.87, "Но самое странное —"], [31.35, 33.56, "следы не уходили обратно."], [34.04, 34.49, "Я"], [34.94, 35.9, "захлопнул дверь и"], [36.25, 37.1, "придвинул к"], [37.76, 38.68, "ней тяжёлый стол."], [39.18, 40.57, "В этот момент рация"], [40.57, 41.83, "снова зашипела."], [42.39, 44.42, "Голос Веры прошептал:"], [44.42, 45.9, "«Илья, не открывай."], [46.38, 47.42, "Я вижу тебя»."], [47.81, 49.33, "Я резко обернулся."], [49.7, 51.35, "В окне никого."], [51.35, 52.12, "На стекле"], [52.58, 54.44, "медленно проступили три"], [54.94, 56.83, "короткие полосы,"], [56.83, 59.31, "будто кто-то провёл пальцами"], [59.31, 60.88, "с другой стороны."], [61.38, 62.11, "Я отступил,"], [62.76, 64.63, "но рация заговорила снова:"], [64.63, 66.0, "«Посмотри на стену рядом"], [66.0, 66.49, "с печью»."], [66.49, 67.7, "Я повернул фонарик."], [68.07, 70.28, "На деревянных досках появились"], [70.28, 70.78, "свежие"], [71.25, 71.91, "царапины."], [72.36, 74.5, "Они складывались в одно"], [74.5, 74.72, "слово —"], [75.14, 75.66, "«БЕГИ»."], [75.66, 77.12, "Я хотел выскочить"], [77.6, 79.01, "через заднюю дверь,"], [79.5, 80.05, "но за ней"], [80.44, 81.96, "уже кто-то трижды"], [82.53, 83.87, "постучал. Я замер."], [84.22, 86.2, "Из рации донёсся шёпот:"], [86.2, 87.27, "«Не верь голосу»."], [87.79, 88.84, "И тут из-за входной"], [88.84, 90.4, "двери раздался мой собственный"], [90.4, 90.85, "голос:"], [91.71, 93.01, "«Илья, открой. 