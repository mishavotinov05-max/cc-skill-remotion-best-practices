[[0.05, 2.07, "До зомби-апокалипсиса оставалось"], [2.05, 4.11, "три дня, но заражение уже"], [4.09, 5.79, "добралось до соседнего города."], [6.09, 7.71, "Когда я увидел предупреждение"], [7.69, 8.51, "на телефоне,"], [8.49, 9.95, "сразу побежал к остальным."], [10.2, 12.03, "Мы решили ускорить подготовку."], [12.33, 14.43, "Первым делом проверили генераторы,"], [14.41, 16.49, "вентиляцию и запасы продуктов."], [16.93, 18.79, "Вдруг электричество во всей"], [18.77, 19.96, "деревне отключилось."], [20.23, 22.33, "Мы запустили резервные генераторы,"], [22.31, 24.37, "но почти сразу пропала мобильная"], [24.35, 24.75, "связь."], [25.07, 26.73, "Я поднялся на поверхность и"], [26.71, 28.57, "заметил над лесом огромное"], [28.55, 29.63, "серое облако."], [30.0, 31.86, "Оно медленно двигалось прямо"], [31.84, 32.46, "к деревне."], [32.79, 34.85, "Я приказал всем срочно собирать"], [34.83, 35.2, "вещи."], [35.5, 37.44, "Люди начали спускаться в бункер,"], [37.42, 38.52, "а мы с дядей Витей"], [38.5, 40.17, "проверяли герметичные двери."], [40.48, 41.58, "Но тут выяснилось,"], [41.56, 43.46, "что внутри всего сорок девять"], [43.44, 43.96, "человек."], [44.26, 45.71, "Одного жителя не хватало."], [46.07, 47.77, "Я выбежал наружу и увидел"], [47.75, 48.85, "бабушку возле дома."], [49.09, 50.63, "Она пыталась забрать старую"], [50.61, 51.77, "сумку с документами."], [52.09, 53.43, "Я схватил её за руку,"], [53.41, 54.74, "и мы побежали к бункеру."], [55.06, 57.12, "В этот момент облако накрыло"], [57.1, 57.6, "деревню."], [57.9, 59.8, "На крышах появились странные"], [59.78, 60.73, "тёмные пятна."], [61.01, 62.63, "Мы успели забежать внутрь и"], [62.61, 64.0, "захлопнули тяжёлую дверь."], [64.3, 66.4, "Я уже собирался включить вентиляцию,"], [66.38, 68.4, "когда заметил на экране фильтрации"], [68.38, 69.74, "красное предупреждение."], [70.11, 72.37, "Воздух снаружи оказался заражён."], [72.67, 74.33, "А затем датчик показал,"], [74.31, 76.45, "что неизвестные частицы уже"], [76.43, 78.0, "находятся внутри бункера…"]]