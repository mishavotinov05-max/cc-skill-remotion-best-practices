[[0.01, 2.8, "Третий день подготовки к зомби-апокалипсису."], [3.12, 5.19, "В городе появились странные споры."], [5.67, 7.33, "До заражения осталось всего"], [7.31, 8.09, "четыре дня."], [8.62, 10.48, "Я загрузил последние припасы"], [10.46, 12.33, "и отправился к бабушке в деревню."], [12.7, 14.44, "Там живёт пятьдесят человек,"], [14.42, 15.76, "и я решил построить для"], [15.74, 17.75, "всех огромный подземный бункер."], [18.12, 19.74, "По приезде я сразу нанял"], [19.72, 21.58, "несколько экскаваторов и собрал"], [21.56, 22.47, "местных жителей."], [22.82, 24.36, "Уже через пару часов мы"], [24.34, 26.31, "начали рыть огромный котлован."], [26.78, 28.43, "Работа шла полным ходом."], [28.8, 30.74, "Мы залили бетонное основание,"], [30.72, 33.02, "укрепили стены и начали разделять"], [33.0, 34.08, "бункер на комнаты."], [34.52, 36.62, "Но самое сложное было впереди."], [37.05, 37.79, "Я подсчитал,"], [37.77, 39.43, "что для трёх лет выживания"], [39.41, 41.31, "нам понадобится около сорока"], [41.29, 42.1, "тонн еды."], [42.45, 44.23, "Мы заказали несколько грузовиков"], [44.21, 45.03, "с крупами,"], [45.01, 45.87, "консервами,"], [45.85, 47.87, "макаронами и другими продуктами"], [47.85, 49.0, "длительного хранения."], [49.43, 50.84, "Следом занялись водой."], [51.15, 52.77, "Недалеко от деревни находился"], [52.75, 53.84, "подземный источник."], [54.11, 55.81, "Мы протянули от него трубы,"], [55.79, 57.21, "установили насосы,"], [57.19, 59.28, "фильтры и огромные резервуары."], [59.56, 61.18, "Теперь с водой проблем быть"], [61.16, 61.66, "не должно."], [62.05, 64.11, "Затем мы установили вентиляционные"], [64.09, 65.83, "шахты, воздушные фильтры,"], [65.81, 68.07, "канализационные трубы и резервные"], [68.05, 68.64, "генераторы."], [68.99, 71.21, "Внутри появились спальные комнаты,"], [71.19, 73.33, "кухня, склад продуктов и даже"], [73.31, 75.1, "небольшая медицинская комната."], [75.53, 77.39, "К вечеру большая часть основных"], [77.37, 78.58, "работ была завершена."], [78.9, 80.68, "Я вышел на поверхность проверить"], [80.66, 82.95, "телефон и увидел срочное сообщение."], [83.34, 85.24, "В соседнем городе зафиксировали"], [85.22, 86.96, "первые случаи неизвестного"], [86.94, 87.53, "заражения."], [87.82, 89.92, "А ведь до апокалипсиса оставалось"], [89.9, 90.89, "ещё три дня…"]]