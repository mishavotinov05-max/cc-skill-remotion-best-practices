[[0.13, 1.55, "Я выбежал из дома и"], [1.53, 2.43, "увидел то,"], [2.41, 4.03, "от чего у меня остановилось"], [4.01, 4.51, "сердце."], [5.07, 6.55, "Но всё началось раньше."], [6.95, 8.45, "Кто-то положил руку мне на"], [8.43, 9.6, "плечо и прошептал:"], [10.02, 11.08, "«Не оборачивайся»."], [11.65, 12.3, "Я замер."], [12.82, 14.4, "Рука медленно соскользнула"], [14.38, 14.91, "с куртки."], [15.26, 17.32, "Вдруг рация закричала голосом"], [17.3, 17.62, "Веры:"], [17.96, 18.54, "«Илья!"], [18.64, 20.46, "Выходи через окно! Быстро!»"], [20.87, 22.17, "Я схватил ледоруб,"], [22.15, 24.15, "разбил стекло и вылез наружу."], [24.42, 25.71, "Но когда обернулся,"], [25.95, 27.0, "дома уже не было."], [27.31, 29.29, "Передо мной стояла только старая"], [29.27, 30.34, "деревянная дверь."], [30.72, 32.13, "Прямо посреди снега."], [32.62, 34.36, "Я побежал вниз по склону."], [34.46, 35.76, "Ветер сбивал с ног,"], [35.74, 37.16, "а фонарик почти погас."], [37.56, 39.3, "Через несколько минут я заметил"], [39.28, 40.14, "впереди свет."], [40.46, 41.56, "Я бросился к нему."], [41.96, 44.25, "И снова увидел тот самый дом."], [44.61, 46.39, "Только теперь на двери висела"], [46.37, 46.97, "табличка:"], [47.39, 48.6, "«Спасательный пункт."], [48.82, 50.79, "Девятьсот восемьдесят шестой год»."], [51.35, 52.52, "Я заглянул в окно."], [53.06, 55.08, "Внутри сидел человек в красной"], [55.06, 55.55, "куртке."], [55.91, 56.81, "Точно такой же,"], [56.79, 57.5, "как у меня."], [57.91, 59.63, "Он медленно поднял рацию."], [59.99, 62.05, "И я услышал собственный голос:"], [62.53, 62.98, "«Вера,"], [63.43, 64.37, "я нашёл дом."], [64.59, 65.61, "Здесь безопасно»."], [66.06, 66.86, "Я отступил."], [67.34, 68.68, "На стене рядом с дверью"], [68.66, 70.1, "появилось новое имя."], [70.61, 71.14, "Илья."], [71.53, 73.33, "А под ним сегодняшняя дата."], [73.77, 75.26, "Вдруг рация зашипела."], [75.68, 77.81, "«Илья, мы нашли твою палатку."], [78.1, 79.96, "Но ты пропал три дня назад»."], [80.4, 81.94, "Я посмотрел на свои руки."], [82.35, 84.13, "Они начали покрываться инеем."], [84.58, 86.17, "И тут дверь открылась."], [86.58, 88.81, "Из темноты донёсся мой голос:"], [89.37, 89.93, "«Заходи."], [90.38, 91.7, "Теперь твоя очередь»."]]